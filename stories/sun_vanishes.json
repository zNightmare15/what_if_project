      "countdownFrom": 8.033,
      "timeScale": 1.0,
      "format": "0:0{sec.3}"
    },
    {
      "id": "light_arrival_countdown",
      "start": 8.033,
      "end": 16.0,
      "label": "LAST SUNLIGHT EN ROUTE",
      "mode": "slowmo_countdown",
      "countdownFrom": 8.0,
      "timeScale": 1.0,
      "format": "0:0{sec.3}"
    },
    {
      "id": "darkness_static",
      "start": 16.0,
      "end": 45.0,
      "label": "ROGUE PLANET",
      "mode": "static_serif",
      "staticText": "LOST IN SPACE",
      "fadeOutStart": 43.5,
      "fadeOutEnd": 45.0
    }
  ],
  "subtracks": [
    {
      "start": 0.0,
      "end": 8.033,
      "type": "static",
      "text": "EARTH ORBITS THE SUN AT 67,000 MPH"
    },
    {
      "start": 8.033,
      "end": 16.0,
      "type": "static",
      "text": "WITHOUT GRAVITY, EARTH FLIES OFF IN A STRAIGHT LINE"
    },
    {
      "start": 16.0,
      "end": 24.0,
      "type": "static",
      "text": "THE LAST PHOTONS ARRIVE — TOTAL DARKNESS FALLS"
    },
    {
      "start": 24.0,
      "end": 45.0,
      "type": "static",
      "text": "SURFACE TEMPERATURE DROPS TO -100°F IN DAYS"
    }
