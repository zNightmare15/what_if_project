  "subtitles": [
    { "start": 0.5, "end": 4.0, "text": "Earth orbits the Sun at 67,000 mph." },
    { "start": 8.033, "end": 12.0, "text": "Gravity vanishes instantly." },
    { "start": 12.2, "end": 15.8, "text": "Earth hurtles into interstellar space in a straight line." },
    { "start": 16.0, "end": 20.0, "text": "8 minutes and 20 seconds later... the last sunlight arrives." },
    { "start": 20.5, "end": 25.0, "text": "Total darkness blankets the globe." },
    { "start": 25.5, "end": 32.0, "text": "Oceans freeze into thick planetary ice sheets." },
    { "start": 32.5, "end": 43.0, "text": "Earth becomes a frozen rogue planet wandering the galaxy forever." }
