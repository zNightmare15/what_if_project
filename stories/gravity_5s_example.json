  "subtitles": [
    { "start": 5.0, "end": 7.8, "text": "You're driving on a coastal highway." },
    { "start": 8.5, "end": 12.2, "text": "Nothing holds the atmosphere down<br>anymore." },
    { "start": 15.5, "end": 19.4, "text": "Your car lifts off the asphalt into mid-air." },
    { "start": 20.3, "end": 23.9, "text": "Earth's spin flings the ocean into the sky." },
    { "start": 24.3, "end": 27.7, "text": "And the real danger is right beneath your feet." },
    { "start": 30.8, "end": 34.8, "text": "Earth's core is compressed at 3.6 million atmospheres." },
    { "start": 36.0, "end": 40.0, "text": "Without gravity, the planet uncoils like a spring." },
    { "start": 43.5, "end": 48.8, "text": "The crust shatters outward into open space." },
    { "start": 49.4, "end": 54.4, "text": "The Moon breaks orbit and sails into the dark." },
    { "start": 64.6, "end": 68.0, "text": "Gravity snaps back to full strength." },
    { "start": 68.4, "end": 71.8, "text": "And an entire highway falls back down on itself." }
  ],
  "outro": {
    "titleHTML": "What if <span class=\"hl\">gravity</span> disappeared<br>for 5 seconds?",
    "subHTML": "GRAVITY IS 10³⁶ TIMES WEAKER THAN ELECTROMAGNETISM<br>YET IT ALONE HOLDS EVERY PLANET AND STAR TOGETHER",
    "facts": [
